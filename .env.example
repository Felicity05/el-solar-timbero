# The project URL is public; the service role key must remain server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Optional server-only runtime URL override (avoids build-time public URL inlining).
# SUPABASE_URL=http://127.0.0.1:54321
# Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Canonical HTTPS URL after deployment (Vercel also provides a default).
SITE_URL=http://localhost:3000
# Vercel's IP header is used automatically. For another host, only set this
# if your trusted proxy OVERWRITES it and direct origin access is blocked.
# Without a trusted IP header, visitors share a conservative fallback bucket.
# RSVP_TRUSTED_IP_HEADER=x-forwarded-for

# Server-only selection; both are required to enable registration. DB eligibility is rechecked.
RSVP_ENABLED=false
RSVP_EVENT_SLUG=
# LOCAL ONLY example (with local URL/key): RSVP_EVENT_SLUG=dev-rsvp-test-2026-12-31
