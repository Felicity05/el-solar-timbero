# The project URL is public; the service role key must remain server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Optional server-only runtime URL override (avoids build-time public URL inlining).
# SUPABASE_URL=http://127.0.0.1:54321
# Optional safe RPC stage/timing logs in the Next.js server terminal:
# RSVP_DEBUG=true
# Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Canonical HTTPS URL after deployment (Vercel also provides a default).
SITE_URL=http://localhost:3000
# Vercel's IP header is used automatically. For another host, only set this
# if your trusted proxy OVERWRITES it and direct origin access is blocked.
# Without a trusted IP header, visitors share a conservative fallback bucket.
# RSVP_TRUSTED_IP_HEADER=x-forwarded-for

# Events are discovered from the database; no event slug configuration is needed.
# Optional emergency override to close RSVP registration (paid sales use ticket_sales_open):
# RSVP_ENABLED=false

# Stripe TEST MODE locally. Only publishable key is sent to browsers.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
# Use the whsec_ printed by the local Stripe CLI listener, NOT a dashboard endpoint's secret.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Production only: explicit opt-in after test-mode verification. Never set locally.
# STRIPE_LIVE_MODE=true

# Server-only Gmail SMTP. Use a Google App Password, NEVER your normal password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional sender display name (default El Solar Timbero), or a verified Gmail send-as address.
TICKET_EMAIL_FROM=

# Server-only staff door access. Never prefix these with NEXT_PUBLIC_.
# Set a shared 6–12 digit PIN (prefer 8+ digits), and your actual ticketed event slug.
CHECK_IN_PIN=
CHECK_IN_EVENT_SLUG=
# Generate independently: openssl rand -hex 32 (never reuse the PIN).
CHECK_IN_SESSION_SECRET=
